# Tutorial images only. Nothing in this folder ever runs as a script.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Require all denied
<FilesMatch "\.(jpg|png|webp|gif)$">
    Require all granted
</FilesMatch>

# Every file gets a new random name, so a cached copy never goes stale.
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|png|webp|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
